{
  "manifest_version": 3,
  "name": "Sportlink Waterpolo Assistant",
  "version": "1.2.1",
  "description": "Fast opponent contact & swimming pool lookup for Sportlink Club waterpolo secretaries.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Sportlink Waterpolo Quick Lookup",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://club.sportlink.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://club.sportlink.com/*"],
      "js": ["interceptor.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://club.sportlink.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-lookup": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Toggle Sportlink Waterpolo Quick Lookup"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
